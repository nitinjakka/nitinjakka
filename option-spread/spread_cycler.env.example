# Copy to spread_cycler.env and fill in. NEVER commit the real file.
# ---------------------------------------------------------------------------
RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_password
# Only if you use an authenticator app: the TOTP *secret* (setup key),
# not the 6-digit code.
RH_MFA_SECRET=

# 0 = PAPER (simulated fills at the mid, no real orders)  <-- start here
# 1 = LIVE  (places REAL multi-leg option orders)
LIVE=0

# Account to trade. Empty = default account.
RH_ACCOUNT_NUMBER=

# --- What to trade ---------------------------------------------------------
SYMBOL=SPY
# call = bearish call credit spread (profits if price stays BELOW short strike)
# put  = bullish put credit spread  (profits if price stays ABOVE short strike)
SIDE=call
WIDTH=1.0
QUANTITY=1
# Blank = today's expiry (0DTE). Or pin a date: 2026-08-07
EXPIRY=

# --- The cycle rule --------------------------------------------------------
MAX_CYCLES=10
# Credit to target on cycle 1 (per share; $0.32 = $32 per contract)
TARGET_CREDIT=0.32
# Subtract this from the achieved credit for each next cycle ("less price").
# Set 0 to keep every cycle at the same credit -- see the risk note below.
CREDIT_STEP=0.02
# Never sell a spread for less than this; cycling stops when it's reached.
MIN_CREDIT=0.10
# Short strike must be at least this % out of the money.
MIN_OTM_PCT=0.10

# --- Exits -----------------------------------------------------------------
# Close once this % of the collected credit is captured (50 = the usual rule).
PROFIT_PCT=50
# Close if the spread's value reaches credit x this (2.0 = lose ~1x credit).
STOP_MULT=2.0
# Realized-loss kill switch for the session, in dollars.
MAX_DAILY_LOSS=200

# --- Timing (ET) -----------------------------------------------------------
ENTRY_CUTOFF=15:00
FLATTEN_TIME=15:45
POLL_SECONDS=10

# --- Limit-order price walking --------------------------------------------
ORDER_TIMEOUT=90
REPRICE_SECONDS=15
PRICE_STEP=0.01

# ---------------------------------------------------------------------------
# RISK NOTE ON CREDIT_STEP
# A $1.00-wide spread sold for $0.32 risks $68 to make $32 (~68% wins to break
# even). Each CREDIT_STEP makes that worse: $0.18 credit risks $82 to make $18
# (~82% wins). Ten cycles compound the exposure. CREDIT_STEP=0 holds it flat.
# ---------------------------------------------------------------------------

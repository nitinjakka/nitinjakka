[Unit]
Description=Start the credit-spread cycler on weekday mornings

[Timer]
# 09:35 ET. The server clock is UTC unless you've set it otherwise -- check
# with `timedatectl` and adjust, or set the unit's timezone explicitly.
OnCalendar=Mon-Fri *-*-* 09:35:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target

# Copy to modeb_bot.env and fill in. NEVER commit the real file.
RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_password

# 0 = PAPER (default: signals + simulated fills, NO real orders)
# 1 = LIVE  (places real orders -- read the PDT warning in modeb_bot.py first)
LIVE=0

# Account to trade when LIVE=1 (e.g. 5SE32399). Empty = default account.
RH_ACCOUNT_NUMBER=5SE32399

TICKERS=TSLA,ORCL,PANW,KLAC,AAPL
TRADE_DOLLARS=50
MAX_TRADES_PER_DAY=3
MAX_DAILY_LOSS_PCT=2.0
TARGET_ATR_MULT=0.5
ROOM_FILTER_PCT=0.25

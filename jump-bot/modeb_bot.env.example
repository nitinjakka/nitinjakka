# Copy to modeb_bot.env and fill in. NEVER commit the real file.
RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_password

# 0 = PAPER (default: signals + simulated fills, NO real orders)
# 1 = LIVE  (places real orders -- read the PDT warning in modeb_bot.py first)
LIVE=0

# Account to trade when LIVE=1 (e.g. 5SE32399). Empty = default account.
RH_ACCOUNT_NUMBER=5SE32399

# v2 (auto-trade-watchlist spec): long-only, tiered exits, NO stop-loss
TICKERS=NVDA,AAPL,MSFT,AMZN,GOOGL,GOOG,AVGO,META,TSLA,PLTR,NFLX,SOFI,SPY,ORCL,SMCI,AMD,ARM,SPMO
# position size = buying_power / POSITION_FRACTION  (10 = spec default;
# 5 = twice as aggressive)
POSITION_FRACTION=10
ROOM_FILTER_PCT=0.25
TRAIL_ARM_PCT=2.0
TRAIL_GIVEBACK_PCT=1.0
TP_BAND_LO_PCT=0.5
TP_BAND_HI_PCT=1.0
ADX_THRESHOLD=20
SCORE_THRESHOLD=2

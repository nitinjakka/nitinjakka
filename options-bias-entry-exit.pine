//@version=5
indicator("Options Bias — CALL/PUT Entry & Exit + S/R (any chart)", shorttitle="CALL/PUT Entry-Exit", overlay=true, max_lines_count=500, max_labels_count=500)

// ===================== INPUTS =====================
grpT="Trend"
emaFastLen = input.int(9,  "EMA fast",  group=grpT)
emaSlowLen = input.int(21, "EMA slow",  group=grpT)
emaTrendLen= input.int(50, "EMA trend", group=grpT)

grpM="Momentum"
rsiLen  = input.int(14, "RSI length", group=grpM)
rsiBull = input.int(50, "RSI bull/bear line", group=grpM)
macdF   = input.int(12, "MACD fast", group=grpM)
macdS   = input.int(26, "MACD slow", group=grpM)
macdSig = input.int(9,  "MACD signal", group=grpM)

grpS="Strength / chop filter"
adxLen    = input.int(14,   "ADX/DMI length", group=grpS)
adxThresh = input.float(20, "Min ADX to allow a signal", group=grpS)
useAdxGate= input.bool(true, "NO-GO when ADX below threshold", group=grpS)

grpH="Higher timeframe"
useHTF = input.bool(true, "Use higher-timeframe trend vote", group=grpH)
htfRes = input.timeframe("60", "Higher timeframe", group=grpH)

grpR="Support / Resistance"
pivLeft  = input.int(10, "Pivot left bars",  group=grpR)
pivRight = input.int(10, "Pivot right bars", group=grpR)
srCount  = input.int(3,  "Levels to keep per side", minval=1, maxval=10, group=grpR)
showSR   = input.bool(true, "Show S/R lines", group=grpR)

grpG="Signal / display"
scoreThresh = input.int(2, "Min |score| for CALL/PUT", minval=1, group=grpG)
showLabels  = input.bool(true, "Show ENTRY/EXIT markers", group=grpG)
colorBars   = input.bool(true, "Color bars by bias", group=grpG)
showTable   = input.bool(true, "Show dashboard", group=grpG)
tablePosStr = input.string("Top left", "Dashboard position", options=["Top left","Top center","Top right","Middle left","Middle center","Middle right","Bottom left","Bottom center","Bottom right"], group=grpG)

grpX="Entry / Exit"
atrLen      = input.int(14,   "ATR length", group=grpX)
atrStopMult = input.float(1.5, "Stop-loss = ATR x", step=0.1, group=grpX)
atrTgtMult  = input.float(2.0, "Take-profit = ATR x", step=0.1, group=grpX)
useSrTarget = input.bool(true, "Cap target at nearest S/R level", group=grpX)
useSrFilter = input.bool(true, "Skip entry if S/R closer than buffer", group=grpX)
srBufPct    = input.float(0.25, "S/R entry buffer (%)", step=0.05, group=grpX)
useTimeStop = input.bool(true, "Time exit after N bars", group=grpX)
maxBarsHeld = input.int(30,   "Max bars in trade", minval=1, group=grpX)

// ===================== INDICATORS =====================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaTrend= ta.ema(close, emaTrendLen)
rsiVal  = ta.rsi(close, rsiLen)
[macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdSig)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
htfBull = useHTF ? request.security(syminfo.tickerid, htfRes, close > ta.ema(close, emaTrendLen), lookahead=barmerge.lookahead_off) : na
atrVal  = ta.atr(atrLen)

// ===================== VOTES (+1 = CALL/bull, -1 = PUT/bear) =====================
vEma   = emaFast > emaSlow ? 1 : -1
vTrend = close   > emaTrend ? 1 : -1
vRsi   = rsiVal  > rsiBull  ? 1 : -1
vMacd  = hist    > 0        ? 1 : -1
vDmi   = diPlus  > diMinus  ? 1 : -1
vHtf   = not useHTF ? 0 : (htfBull ? 1 : -1)

score    = vEma + vTrend + vRsi + vMacd + vDmi + vHtf
maxScore = 5 + (useHTF ? 1 : 0)

// ===================== BIAS =====================
chop     = useAdxGate and adxVal < adxThresh
biasCode = chop ? 0 : (score >= scoreThresh ? 1 : score <= -scoreThresh ? -1 : 0)
conf     = math.round(math.abs(score) / maxScore * 100)

newCall = biasCode ==  1 and biasCode[1] !=  1
newPut  = biasCode == -1 and biasCode[1] != -1

// ===================== SUPPORT / RESISTANCE (pivot-based) =====================
var line[] resLines = array.new_line()
var line[] supLines = array.new_line()
ph = ta.pivothigh(pivLeft, pivRight)
pl = ta.pivotlow(pivLeft, pivRight)

if showSR and not na(ph)
    ln = line.new(bar_index - pivRight, ph, bar_index, ph, xloc.bar_index, extend.right, color=color.new(color.red, 20), width=1)
    array.push(resLines, ln)
    if array.size(resLines) > srCount
        line.delete(array.shift(resLines))
if showSR and not na(pl)
    ln = line.new(bar_index - pivRight, pl, bar_index, pl, xloc.bar_index, extend.right, color=color.new(color.teal, 20), width=1)
    array.push(supLines, ln)
    if array.size(supLines) > srCount
        line.delete(array.shift(supLines))

f_nearestAbove(arr, px) =>
    lvl = float(na)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = line.get_y1(array.get(arr, i))
            if v > px and (na(lvl) or v < lvl)
                lvl := v
    lvl
f_nearestBelow(arr, px) =>
    lvl = float(na)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = line.get_y1(array.get(arr, i))
            if v < px and (na(lvl) or v > lvl)
                lvl := v
    lvl

nRes = f_nearestAbove(resLines, close)
nSup = f_nearestBelow(supLines, close)

// ===================== ENTRY / EXIT ENGINE =====================
var int   pos      = 0        // 1 = in CALL trade, -1 = in PUT trade, 0 = flat
var float entryPx  = na
var float stopPx   = na
var float tgtPx    = na
var int   entryBar = na

bool   enterCall = false
bool   enterPut  = false
bool   exitTrade = false
string exitWhy   = na
float  exitPx    = na

// ---- exits (checked before new entries, so a bias flip can reverse the trade) ----
if pos == 1
    if low <= stopPx
        exitTrade := true
        exitWhy   := "STOP"
        exitPx    := stopPx
    else if high >= tgtPx
        exitTrade := true
        exitWhy   := "TARGET"
        exitPx    := tgtPx
    else if biasCode != 1
        exitTrade := true
        exitWhy   := biasCode == -1 ? "BIAS FLIP" : "BIAS LOST"
        exitPx    := close
    else if useTimeStop and bar_index - entryBar >= maxBarsHeld
        exitTrade := true
        exitWhy   := "TIME"
        exitPx    := close
else if pos == -1
    if high >= stopPx
        exitTrade := true
        exitWhy   := "STOP"
        exitPx    := stopPx
    else if low <= tgtPx
        exitTrade := true
        exitWhy   := "TARGET"
        exitPx    := tgtPx
    else if biasCode != -1
        exitTrade := true
        exitWhy   := biasCode == 1 ? "BIAS FLIP" : "BIAS LOST"
        exitPx    := close
    else if useTimeStop and bar_index - entryBar >= maxBarsHeld
        exitTrade := true
        exitWhy   := "TIME"
        exitPx    := close

if exitTrade
    pos := 0

// ---- entries (fresh bias flip + enough room to the nearest S/R level) ----
roomUp = na(nRes) ? 100.0 : (nRes - close) / close * 100
roomDn = na(nSup) ? 100.0 : (close - nSup) / close * 100

if pos == 0 and newCall and (not useSrFilter or roomUp >= srBufPct)
    pos       := 1
    entryPx   := close
    stopPx    := close - atrVal * atrStopMult
    tgtPx     := close + atrVal * atrTgtMult
    if useSrTarget and not na(nRes) and nRes < tgtPx
        tgtPx := nRes
    entryBar  := bar_index
    enterCall := true

if pos == 0 and newPut and (not useSrFilter or roomDn >= srBufPct)
    pos      := -1
    entryPx  := close
    stopPx   := close + atrVal * atrStopMult
    tgtPx    := close - atrVal * atrTgtMult
    if useSrTarget and not na(nSup) and nSup > tgtPx
        tgtPx := nSup
    entryBar := bar_index
    enterPut := true

// ===================== VISUALS =====================
plotshape(showLabels and enterCall, "ENTER CALL", shape.triangleup,   location.belowbar, color.teal, text="BUY\nCALL", textcolor=color.white, size=size.small)
plotshape(showLabels and enterPut,  "ENTER PUT",  shape.triangledown, location.abovebar, color.red,  text="BUY\nPUT",  textcolor=color.white, size=size.small)

if showLabels and exitTrade
    label.new(bar_index, high, "EXIT " + exitWhy + "\n" + str.tostring(exitPx, format.mintick), style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

plot(pos != 0 ? entryPx : na, "Entry price", color=color.new(color.gray, 0),  style=plot.style_linebr)
plot(pos != 0 ? stopPx  : na, "Stop-loss",   color=color.new(color.red, 0),   style=plot.style_linebr)
plot(pos != 0 ? tgtPx   : na, "Target",      color=color.new(color.green, 0), style=plot.style_linebr)

barcolor(colorBars ? (biasCode==1 ? color.new(color.teal,55) : biasCode==-1 ? color.new(color.red,55) : na) : na)

alertcondition(enterCall, "ENTER CALL", "Enter CALL: bias flipped bullish, ADX ok, room to resistance")
alertcondition(enterPut,  "ENTER PUT",  "Enter PUT: bias flipped bearish, ADX ok, room to support")
alertcondition(exitTrade, "EXIT trade", "Exit open options trade (stop / target / bias / time)")

// ===================== DASHBOARD =====================
f_arrow(v) => v > 0 ? "▲ CALL" : v < 0 ? "▼ PUT" : "• off"
f_col(v)   => v > 0 ? color.teal : v < 0 ? color.red : color.gray
f_pos(s)   => s=="Top left" ? position.top_left : s=="Top center" ? position.top_center : s=="Top right" ? position.top_right : s=="Middle left" ? position.middle_left : s=="Middle center" ? position.middle_center : s=="Middle right" ? position.middle_right : s=="Bottom left" ? position.bottom_left : s=="Bottom center" ? position.bottom_center : position.bottom_right
var table dash = table.new(f_pos(tablePosStr), 2, 13, border_width=1, frame_color=color.gray, frame_width=1)
if showTable and barstate.islast
    biasTxt = biasCode==1 ? "CALL" : biasCode==-1 ? "PUT" : (chop ? "NO-GO (chop)" : "NEUTRAL")
    biasCol = biasCode==1 ? color.teal : biasCode==-1 ? color.red : color.gray
    resTxt = na(nRes) ? "—" : str.tostring(nRes, format.mintick)+"  (+"+str.tostring((nRes-close)/close*100, "#.##")+"%)"
    supTxt = na(nSup) ? "—" : str.tostring(nSup, format.mintick)+"  ("+str.tostring((nSup-close)/close*100, "#.##")+"%)"
    posTxt = pos==1 ? "IN CALL" : pos==-1 ? "IN PUT" : "FLAT"
    posCol = pos==1 ? color.teal : pos==-1 ? color.red : color.gray
    table.cell(dash,0,0,"BIAS", text_color=color.white, bgcolor=color.new(color.gray,20))
    table.cell(dash,1,0,biasTxt+"  "+str.tostring(conf)+"%", text_color=color.white, bgcolor=biasCol)
    table.cell(dash,0,1,"EMA "+str.tostring(emaFastLen)+"/"+str.tostring(emaSlowLen), text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,1,f_arrow(vEma),  text_color=f_col(vEma))
    table.cell(dash,0,2,"Px vs EMA"+str.tostring(emaTrendLen), text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,2,f_arrow(vTrend),text_color=f_col(vTrend))
    table.cell(dash,0,3,"RSI "+str.tostring(math.round(rsiVal)), text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,3,f_arrow(vRsi),  text_color=f_col(vRsi))
    table.cell(dash,0,4,"MACD", text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,4,f_arrow(vMacd), text_color=f_col(vMacd))
    table.cell(dash,0,5,"DMI", text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,5,f_arrow(vDmi),  text_color=f_col(vDmi))
    table.cell(dash,0,6,"HTF "+htfRes, text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,6,useHTF?f_arrow(vHtf):"off", text_color=f_col(vHtf))
    table.cell(dash,0,7,"ADX "+str.tostring(math.round(adxVal)), text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,7,adxVal>=adxThresh?"strong":"weak", text_color=adxVal>=adxThresh?color.teal:color.gray)
    table.cell(dash,0,8,"Resistance", text_color=color.white, bgcolor=color.new(color.red,40))
    table.cell(dash,1,8,resTxt, text_color=color.red)
    table.cell(dash,0,9,"Support", text_color=color.white, bgcolor=color.new(color.teal,40))
    table.cell(dash,1,9,supTxt, text_color=color.teal)
    table.cell(dash,0,10,"Position", text_color=color.white, bgcolor=color.new(color.gray,20))
    table.cell(dash,1,10,posTxt, text_color=color.white, bgcolor=posCol)
    table.cell(dash,0,11,"Entry / Stop", text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,11,pos!=0 ? str.tostring(entryPx, format.mintick)+" / "+str.tostring(stopPx, format.mintick) : "—", text_color=color.white)
    table.cell(dash,0,12,"Target", text_color=color.white, bgcolor=color.new(color.gray,70))
    table.cell(dash,1,12,pos!=0 ? str.tostring(tgtPx, format.mintick) : "—", text_color=color.green)

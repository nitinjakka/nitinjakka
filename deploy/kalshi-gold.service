[Unit]
Description=Kalshi gold 15-min trading bot (live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nitinjakka
EnvironmentFile=/etc/kalshi-bot.env
ExecStart=/usr/bin/python3 /opt/nitinjakka/kalshi_gold_bot.py --live
Restart=always
RestartSec=5
StandardOutput=append:/opt/nitinjakka/kalshi_gold.out
StandardError=append:/opt/nitinjakka/kalshi_gold.out

[Install]
WantedBy=multi-user.target

//@version=6
// =============================================================================
//  Suite Mode B (all-day session breakout) - STRATEGY version for backtesting
//  Use on a 5-MINUTE chart, regular session only. Matches strategy-spec.md 5B:
//    entry: close breaks running session high (long) / low (short) with VWAP
//           agreement, minutes [5, 360) from open, <=10 trades/day,
//           skip if a confirmed pivot level is within 0.25% of price
//    stop:  opposite side of the opening range (first 5-min bar)
//    target: entry +/- 0.75*ATR(14), capped at nearest confirmed pivot
//    always flat by 15:55; entries fill on signal-bar close
//  Long+short by default; disable shorts for cash-account realism.
//  Tip (Premium): enable Deep Backtesting and the bar magnifier for
//  intrabar-accurate stop/target sequencing over the full history.
// =============================================================================
strategy("Suite Mode B All-Day", overlay = true,
     initial_capital = 100,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.01,
     process_orders_on_close = true, calc_on_every_tick = false)

tgtMult     = input.float(0.75, "Target ATR multiple", step = 0.05)
roomPct     = input.float(0.25, "Pivot room filter %", step = 0.05)
maxPerDay   = input.int(10, "Max trades per day")
entryEndMin = input.int(360, "No entries after minute")
eodFlatMin  = input.int(385, "Flat at minute (385 = 15:55)")
allowLong   = input.bool(true, "Allow longs")
allowShort  = input.bool(true, "Allow shorts")

atr = ta.atr(14)
vw  = ta.vwap
ph  = ta.pivothigh(high, 10, 10)   // confirmed 10 bars after the pivot
pl  = ta.pivotlow(low, 10, 10)

var float[] resA = array.new_float()
var float[] supA = array.new_float()
if not na(ph)
    array.push(resA, ph)
    if array.size(resA) > 3
        array.shift(resA)
if not na(pl)
    array.push(supA, pl)
    if array.size(supA) > 3
        array.shift(supA)

nearestRes(float c) =>
    float best = na
    if array.size(resA) > 0
        for i = 0 to array.size(resA) - 1
            v = array.get(resA, i)
            if v > c and (na(best) or v < best)
                best := v
    best

nearestSup(float c) =>
    float best = na
    if array.size(supA) > 0
        for i = 0 to array.size(supA) - 1
            v = array.get(supA, i)
            if v < c and (na(best) or v > best)
                best := v
    best

// ---- session state (5-min chart assumed: 1 bar = 5 minutes) ----
var float orHi    = na
var float orLo    = na
var float sessHi  = na   // running extremes as of the PREVIOUS bar
var float sessLo  = na
var int   nToday  = 0
var int   barsIn  = 0

if session.isfirstbar
    orHi   := high
    orLo   := low
    sessHi := high
    sessLo := low
    nToday := 0
    barsIn := 0
else
    barsIn += 1
mins = barsIn * 5

// ---- exits: EOD flat ----
if mins >= eodFlatMin
    strategy.cancel_all()
    strategy.close_all(comment = "EOD")

// ---- entries (evaluated against prior-bar session extremes) ----
flat = strategy.position_size == 0
canEnter = flat and not session.isfirstbar and mins >= 5 and
     mins < entryEndMin and nToday < maxPerDay and mins < eodFlatMin

if canEnter
    sigUp = allowLong and close > sessHi and close > vw
    sigDn = allowShort and close < sessLo and close < vw
    if sigUp
        nr = nearestRes(close)
        roomUp = na(nr) ? 100.0 : (nr - close) / close * 100
        if roomUp >= roomPct
            float tgt = close + tgtMult * atr
            if not na(nr) and nr < tgt
                tgt := nr
            strategy.entry("L", strategy.long)
            strategy.exit("Lx", "L", stop = orLo, limit = tgt)
            nToday += 1
    else if sigDn
        ns = nearestSup(close)
        roomDn = na(ns) ? 100.0 : (close - ns) / close * 100
        if roomDn >= roomPct
            float tgt = close - tgtMult * atr
            if not na(ns) and ns > tgt
                tgt := ns
            strategy.entry("S", strategy.short)
            strategy.exit("Sx", "S", stop = orHi, limit = tgt)
            nToday += 1

// ---- update running session extremes AFTER signal evaluation ----
if not session.isfirstbar
    sessHi := math.max(sessHi, high)
    sessLo := math.min(sessLo, low)

plot(vw, "VWAP", color = color.orange)
plot(orHi, "OR high", color = color.new(color.green, 60), style = plot.style_linebr)
plot(orLo, "OR low", color = color.new(color.red, 60), style = plot.style_linebr)

# Copy this file to ".env" and fill in your values.
# Do NOT commit .env to git.

RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_password

# OPTIONAL: only if you use app-based two-factor authentication (TOTP).
# This is the "secret" / setup key Robinhood shows when you enable an
# authenticator app -- NOT the 6-digit code. Leave blank for SMS/email MFA
# (you'll be prompted to type the code once instead).
RH_MFA_SECRET=

# OPTIONAL: extra account numbers, comma-separated. Robinhood's API listing
# does not return newer account types (named second accounts, managed
# "Strategies", agentic accounts). If you have one, find its account number
# in the app (switch to the account -> Settings/menu -> Account numbers) and
# add it here so balance_check can try to fetch it directly.
# Example: RH_EXTRA_ACCOUNTS=123456789,987654321
RH_EXTRA_ACCOUNTS=
